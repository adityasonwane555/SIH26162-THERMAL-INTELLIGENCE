# SIH26162 Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEMO_MODE=true

# Database Configuration (PostgreSQL + PostGIS)
# In DEMO_MODE or local dev without PostgreSQL, SQLite fallback is supported
DATABASE_URL=postgresql://sih_user:sih_secret@localhost:5432/thermal_intelligence
# Fallback local sqlite for instant offline zero-dependency demo:
SQLITE_DB_PATH=data/thermal_intelligence.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# NASA FIRMS API Credentials (Optional in DEMO_MODE)
# Get a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# Data Directories
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_BENCHMARKS_DIR=data/benchmarks
DATA_SYNTHETIC_DIR=data/synthetic
